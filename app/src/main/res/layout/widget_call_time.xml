<?xml version="1.0" encoding="utf-8"?>
<!-- spec: docs/spec.md 5.5.1 表示内容。1x2（横長・低い高さ）実機確認の結果、左右2分割より
     ラベル付き3行縦並びのほうが低背サイズでも余白なく収まったため採用。
     各行は「ラベル(左寄せ) + 値(右寄せ)」の横並び。値の文字列組み立ては Provider 側で行う。
     文字サイズは実機(SH-51C)の 1x2 最小サイズで切れない上限が 17sp。
     値側は桁数が増えた場合（例: "128分 / 70分"）に切れないよう autoSize で 12sp まで自動縮小する。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@color/widget_bg_normal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="2dp">

    <!-- 1行目: 使用（通話時間 / 定額枠） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/widget_time_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="使用"
            android:textSize="17sp"
            android:textColor="@color/widget_text_normal" />

        <TextView
            android:id="@+id/widget_time_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="end"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="@color/widget_text_normal" />

    </LinearLayout>

    <!-- 2行目: 件数（対象通話件数） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/widget_count_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="件数"
            android:textSize="17sp"
            android:textColor="@color/widget_text_normal" />

        <TextView
            android:id="@+id/widget_count_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="end"
            android:textSize="17sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="@color/widget_text_normal" />

    </LinearLayout>

    <!-- 3行目: 金額（概算料金。超過時は注記付きでそのまま右寄せ表示） -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/widget_amount_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="金額"
            android:textSize="17sp"
            android:textColor="@color/widget_text_normal" />

        <TextView
            android:id="@+id/widget_amount_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="end"
            android:textSize="17sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="@color/widget_text_normal" />

    </LinearLayout>

    <!-- 4行目: 超過（定額枠超過時のみ表示。超過がなければ行ごと GONE） -->
    <LinearLayout
        android:id="@+id/widget_overage_row"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="gone">

        <TextView
            android:id="@+id/widget_overage_label"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="超過"
            android:textSize="17sp"
            android:textColor="@color/widget_text_normal" />

        <TextView
            android:id="@+id/widget_overage_value"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginStart="4dp"
            android:gravity="end"
            android:textSize="17sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="17sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="@color/widget_text_normal" />

    </LinearLayout>

</LinearLayout>
