<?xml version="1.0" encoding="utf-8"?>
<!-- spec: docs/spec.md 5.5.1 表示内容。「ラベル(小) + 値(大)」のブロックを2つ縦に並べる。
     アプリ本体の「現在の状況」(5.6.1)と同じ構成にして、両者で見え方を揃えている。
     文字列の組み立ては WidgetPresentation.presentWidget() 側で行う。
     文字サイズはラベル11sp / 値18sp。以前の4行構成では17spが1x2最小サイズの上限だったが、
     ラベルが小さくなった分の余裕を値に回している。
     値は桁数が増えた場合（例: "20.5 / 1419.5分"）に切れないよう autoSize で 12sp まで自動縮小する。
     ラベルも「通話時間 / 無料枠残」が 11 文字と長いため 9sp まで縮小できるようにしている。 -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center_vertical"
    android:background="@color/widget_bg_normal"
    android:paddingHorizontal="8dp"
    android:paddingVertical="2dp">

    <!-- ブロック1: 通話時間（月間定額型は「通話時間 / 無料枠残」） -->
    <LinearLayout
        android:id="@+id/widget_time_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_time_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="@color/widget_text_normal" />

        <TextView
            android:id="@+id/widget_time_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="@color/widget_text_normal" />

    </LinearLayout>

    <!-- ブロック2: 通話金額 -->
    <LinearLayout
        android:id="@+id/widget_amount_block"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="4dp">

        <TextView
            android:id="@+id/widget_amount_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="11sp"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="9sp"
            android:autoSizeMaxTextSize="11sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="@color/widget_text_normal" />

        <TextView
            android:id="@+id/widget_amount_value"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:textSize="18sp"
            android:textStyle="bold"
            android:maxLines="1"
            android:ellipsize="end"
            android:autoSizeTextType="uniform"
            android:autoSizeMinTextSize="12sp"
            android:autoSizeMaxTextSize="18sp"
            android:autoSizeStepGranularity="1sp"
            android:textColor="@color/widget_text_normal" />

    </LinearLayout>

    <!-- 状態表示（権限要求 / 更新中 / 更新失敗）。
         上の2ブロックはラベル+値の構成のため、値欄を流用するとメッセージの位置が揃わない。
         そのため状態表示は専用の1ビューを用意し、他のブロックを全て GONE にして上下左右中央に出す。
         2行メッセージは改行を含む1つの文字列として設定する。 -->
    <TextView
        android:id="@+id/widget_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:gravity="center"
        android:textSize="15sp"
        android:maxLines="2"
        android:ellipsize="end"
        android:visibility="gone"
        android:textColor="@color/widget_text_normal" />

</LinearLayout>
