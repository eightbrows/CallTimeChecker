<?xml version="1.0" encoding="utf-8"?>
<!--
  spec: docs/spec.md 5.8 多言語対応。既定（この values/）は英語、values-ja/ が日本語。
  リソース名の接頭辞:
    action_   ボタン等の操作名          tab_       メイン画面のタブ
    section_  見出し                    label_     「項目名: 値」の項目名
    fmt_      数値を埋め込む書式        unit_      数値の後ろ（英語の通貨は前）に付く単位
    plan_ / theme_ / color_role_ / palette_  選択肢の表示名
    settings_ 設定画面の項目名          note_      入力欄の下に出す注記
    detail_   内訳リストの判定          widget_    ウィジェット専用
  通貨記号の位置は bools.xml の yen_before_value で切り替える（英語は ¥1,220、日本語は 1,220円）。
-->
